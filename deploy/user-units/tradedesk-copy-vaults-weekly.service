[Unit]
Description=tradedesk: weekly paper copy vs vault report to the demo topic (scripts/copy_vaults.py report --tg)
ConditionPathExists=/var/lib/tradedesk-mcp/assistant/copy-vaults.on

[Service]
Type=oneshot
WorkingDirectory=/home/tradedesk/tradedesk-mcp
ExecStart=/home/tradedesk/.local/bin/uv run --quiet python scripts/copy_vaults.py report --tg
TimeoutStartSec=5min
NoNewPrivileges=true
