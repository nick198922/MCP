[Unit]
Description=tradedesk: weekly counters-only report of the assistant_paper journal (read-only DB, no P&L, Telegram)
# Off until this file exists: scripts/server/30-assistant-paper-report-timer.sh creates it ("off" removes it). The
# directory belongs to tradedesk, so any tradedesk process can flip it; not an owner-only switch (as for steps 22, 25-29).
ConditionPathExists=/var/lib/tradedesk-mcp/assistant/assistant-paper-report.on

[Service]
Type=oneshot
WorkingDirectory=/home/tradedesk/tradedesk-mcp
ExecStart=/home/tradedesk/.local/bin/uv run --quiet python scripts/assistant_paper_report.py --telegram
TimeoutStartSec=10min
Nice=10
NoNewPrivileges=true
