# Copy to .env in the repo root (next to docker-compose.yml) and edit before
# `docker compose up`. Everything is optional unless you need that feature.

# HTTP transport (streamable-http for prod; local dev defaults to stdio).
TRADEDESK_TRANSPORT=streamable-http
TRADEDESK_HOST=0.0.0.0
TRADEDESK_PORT=8000

# SQLite history (Phase 2). Empty string disables the store.
TRADEDESK_DB_PATH=/data/tradedesk.sqlite
TRADEDESK_COLLECTOR_ENABLED=1
# Collector cadences (seconds).
TRADEDESK_COLLECT_ATM_TERM_SECONDS=300
TRADEDESK_COLLECT_FUNDING_SECONDS=3600
TRADEDESK_COLLECT_BASIS_SECONDS=300
TRADEDESK_RETENTION_SECONDS=86400
# Retention windows per table (days). 0 disables pruning for that table.
TRADEDESK_RETENTION_ATM_TERM_DAYS=365
TRADEDESK_RETENTION_FUNDING_DAYS=365
TRADEDESK_RETENTION_BASIS_DAYS=365

# HTTP tuning.
TRADEDESK_HTTP_TIMEOUT=10
TRADEDESK_HTTP_RETRIES=2
TRADEDESK_CACHE_SCALE=1.0

# Optional provider keys.
#COINGECKO_API_KEY=
#COINGECKO_PLAN=demo
#COINALYZE_API_KEY=
