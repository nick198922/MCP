[Unit]
Description=tradedesk: weekly Bybit risk-limit ladder snapshot for the paper carry criteria (scripts/paper_ladder_snapshot.py)
# Public endpoint, no keys, no orders. Writes /var/lib/tradedesk-mcp/ladder/<UTC date>-bybit.json (outside git; the
# script creates the directory); scripts/checkpoint_report.py reads it next to docs/paper/ladder/ (item 366).

[Service]
Type=oneshot
WorkingDirectory=/home/tradedesk/tradedesk-mcp
ExecStart=/home/tradedesk/.local/bin/uv run --quiet python scripts/paper_ladder_snapshot.py --out-dir /var/lib/tradedesk-mcp/ladder
TimeoutStartSec=10min
Nice=10
NoNewPrivileges=true
