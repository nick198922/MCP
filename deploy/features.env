# Feature switches of read-only jobs, applied by the MCP service at start (src/tradedesk/features.py).
# The agents may turn a job on here in a pull request: it merges by itself and reaches the server within the hour
# (tradedesk-update restarts the service when main changed). /etc/tradedesk-mcp.env always wins over this file.
# Accepted: TRADEDESK_{COLLECTOR,COLLECT,RETENTION,PAPER,ASSISTANT_SNAPSHOT,ALERTS,TRADERS,OHLCV_HIST,PM_GAP,ASSISTANT_PAPER}_*_{ENABLED,
# SECONDS,MINUTES,HOURS,DAYS,COOLDOWN,VENUES,SYMBOLS,MARKETS,PAGES,TOP_N,USD,INST_TYPE}; keys, tokens, paths, host
# and port are ignored. One NAME=value per line.

# Polymarket <-> Deribit gap snapshots, hourly (IDEA-20261017-polymarket-vs-options-forward); live-checked 2026-10-20
TRADEDESK_PM_GAP_ENABLED=1

# Forward-paper carry A and B (IDEA-20261017-forward-paper-carry); live cycle checked 2026-10-20, bench.json frozen
TRADEDESK_PAPER_CARRY_ENABLED=1

# Assistant's daily paper recommendation (IDEA-20261018-assistant); live run checked 2026-10-20
TRADEDESK_ASSISTANT_PAPER_ENABLED=1

# Hourly scoring of the assistant's trade plans on public candles (plan_add / plan_review); owner decision 2026-10-21
TRADEDESK_PAPER_PLAN_RESOLVE_ENABLED=1

# Daily risk-neutral range forecasts of BTC/ETH with Brier scoring (forecast_log_status); owner decision 2026-10-22
TRADEDESK_PAPER_FORECAST_LOG_ENABLED=1

# Radar archive: one Deribit surface row per day and asset at 19:00 UTC (radar_surface); year backfilled 2026-10-22
TRADEDESK_COLLECT_RADAR_ENABLED=1

# Bybit <-> Deribit daily-option book crossings, hourly + minute mode (IDEA-20261023-bybit-deribit-daily-option-dislocation-forward);
# registration 2 and Bybit spec committed before data, critic review docs/reviews/2026-10-23-option-xvenue-registration2.md
TRADEDESK_COLLECT_OPTION_XVENUE_ENABLED=1

# Binance TradFi-perp best bid/ask + mark/index once a minute, costs for IDEA-20261024-tradfi-perp-offhours-reopen;
# critic approve docs/reviews/2026-10-24-tradfi-spread-collector.md
TRADEDESK_COLLECT_TRADFI_SPREAD_ENABLED=1

# Hourly flow snapshot (book depth, OI, funding, long/short; BTC/ETH x Binance/Bybit/OKX/HL) for
# IDEA-20261028-market-flow-reader step 2 (owner's card); live run 2026-10-28: 14/14 rows, ~40 KB a day
TRADEDESK_COLLECT_FLOW_SNAPSHOT_ENABLED=1

# Liquidation WebSocket stream: Binance USD-M (all symbols; live 2026-10-28: ~25k rows a day on a calm day), Bybit
# (BTC/ETH/SOL) and OKX swaps. Bybit side and OKX contract sizes fixed and checked on live messages 2026-10-28
# (tests/fixtures/liquidations_ws_2026-10-28.json). 600 s windows: the 5 s reconnect gap loses <1 % of the time.
TRADEDESK_COLLECT_LIQUIDATIONS_ENABLED=1
TRADEDESK_COLLECT_LIQUIDATIONS_VENUES=binance,bybit,okx
TRADEDESK_COLLECT_LIQUIDATIONS_WINDOW_SECONDS=600

# Daily cycle regime journal of BTC from 00:05 UTC (cycle_regime_log; IDEA-20261028-btc-cycle-regime-gauge, step 2,
# owner's card); live run 2026-10-28: 7 rows 21-27.10, 27.10 = the tool's numbers, a re-run writes nothing
TRADEDESK_COLLECT_CYCLE_REGIME_ENABLED=1
