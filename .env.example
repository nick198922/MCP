# Copy to .env (never commit it). Phase 0-1 needs NO keys: all sources are public.

# --- server ---
TRADEDESK_TRANSPORT=stdio          # stdio (local) | streamable-http (always-on server)
TRADEDESK_HOST=127.0.0.1
TRADEDESK_PORT=8000
TRADEDESK_HTTP_TIMEOUT=10
TRADEDESK_HTTP_RETRIES=2
TRADEDESK_CACHE_SCALE=1.0          # 0 disables caching

# --- optional data keys (later phases) ---
COINALYZE_API_KEY=

# --- exchange trading keys (Phase 4 only). Create them WITHOUT withdrawal rights and with an IP allow-list. ---
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
