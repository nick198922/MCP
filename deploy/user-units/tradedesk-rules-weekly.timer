[Unit]
Description=tradedesk-rules-weekly (Monday 09:00 Europe/Kyiv)

[Timer]
# Start of the week: the ISO week (UTC) just completed, and the new one.
OnCalendar=Mon *-*-* 09:00:00 Europe/Kyiv
# A weekly summary sent days later after a reboot is not wanted: no catch-up run.
Persistent=false

[Install]
WantedBy=timers.target
