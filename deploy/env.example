# Copy to .env in the repo root (next to docker-compose.yml) and edit before
# `docker compose up`. Everything is optional unless you need that feature.

# HTTP transport (streamable-http for prod; local dev defaults to stdio).
TRADEDESK_TRANSPORT=streamable-http
TRADEDESK_HOST=0.0.0.0
TRADEDESK_PORT=8000

# SQLite history (Phase 2). Empty string disables the store.
TRADEDESK_DB_PATH=/data/tradedesk.sqlite
TRADEDESK_COLLECTOR_ENABLED=1
# Collector cadences (seconds).
TRADEDESK_COLLECT_ATM_TERM_SECONDS=300
TRADEDESK_COLLECT_FUNDING_SECONDS=3600
TRADEDESK_COLLECT_BASIS_SECONDS=300
# Historical OHLCV: markets = "venue:symbol:timeframe,…".
#TRADEDESK_COLLECT_OHLCV_HIST_ENABLED=1
#TRADEDESK_COLLECT_OHLCV_HIST_MARKETS=binanceusdm:BTC/USDT:USDT:1h,binanceusdm:ETH/USDT:USDT:1h
#TRADEDESK_COLLECT_OHLCV_HIST_SECONDS=3600
#TRADEDESK_OHLCV_HIST_BACKFILL_DAYS=365
#TRADEDESK_RETENTION_OHLCV_HIST_DAYS=0  # 0 = keep forever
# Daily CoinGecko supply snapshot (table supply_snapshot, top PAGES x 250 coins); on by default with the collector.
#TRADEDESK_COLLECT_SUPPLY_ENABLED=1
#TRADEDESK_COLLECT_SUPPLY_PAGES=4
# Strong traders' public accounts: daily leaderboards (HL accounts >= MIN_ACCOUNT_USD, Polymarket overall + crypto)
# and hourly positions of the top N by month and all-time PnL. On by default with the collector.
#TRADEDESK_COLLECT_TRADERS_ENABLED=1
#TRADEDESK_TRADERS_TOP_N=100
#TRADEDESK_TRADERS_MIN_ACCOUNT_USD=500000
# Liquidation WS collector. Needs TRADEDESK_COLLECTOR_ENABLED=1 too.
#TRADEDESK_COLLECT_LIQUIDATIONS_ENABLED=1
#TRADEDESK_COLLECT_LIQUIDATIONS_VENUES=binance,bybit,okx
#TRADEDESK_COLLECT_LIQUIDATIONS_WINDOW_SECONDS=60
#TRADEDESK_COLLECT_LIQUIDATIONS_RESTART_SECONDS=5
#TRADEDESK_COLLECT_LIQUIDATIONS_BYBIT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
#TRADEDESK_COLLECT_LIQUIDATIONS_OKX_INST_TYPE=SWAP
# Assistant snapshot JSON for the dashboard (scripts/server/19-assistant-snapshot.sh). Needs TRADEDESK_COLLECTOR_ENABLED=1 too.
#TRADEDESK_ASSISTANT_SNAPSHOT_ENABLED=1
#TRADEDESK_ASSISTANT_SNAPSHOT_SECONDS=600
#TRADEDESK_ASSISTANT_SNAPSHOT_PATH=/var/lib/tradedesk-mcp/assistant/snapshot.json
# Paper journal of the assistant's recommendations: one method pick a day after 09:00 UTC (local SQLite, no orders). Needs the collector too.
#TRADEDESK_ASSISTANT_PAPER_ENABLED=1
#TRADEDESK_ASSISTANT_PAPER_SECONDS=3600
#TRADEDESK_ASSISTANT_PAPER_DEPOSIT_USD=10000
#TRADEDESK_ASSISTANT_PAPER_RISK_PCT=1
# Hourly scoring of the assistant's trade plans (plan_add / plan_review) on public candles (local SQLite, no orders). Needs the collector too.
#TRADEDESK_PAPER_PLAN_RESOLVE_ENABLED=1
#TRADEDESK_PAPER_PLAN_RESOLVE_SECONDS=3600
# Forecast journal: daily risk-neutral range forecasts of BTC/ETH after 09:00 UTC, settled at the Deribit delivery (local SQLite, no orders). Needs the collector too.
#TRADEDESK_PAPER_FORECAST_LOG_ENABLED=1
#TRADEDESK_PAPER_FORECAST_LOG_SECONDS=3600
TRADEDESK_RETENTION_SECONDS=86400
# Retention windows per table (days). 0 disables pruning for that table.
TRADEDESK_RETENTION_ATM_TERM_DAYS=365
TRADEDESK_RETENTION_FUNDING_DAYS=365
TRADEDESK_RETENTION_BASIS_DAYS=365

# HTTP tuning.
TRADEDESK_HTTP_TIMEOUT=10
TRADEDESK_HTTP_RETRIES=2
TRADEDESK_CACHE_SCALE=1.0

# Alerts (Phase 2.5). Rules JSON path is required when alerts_enabled=1.
# Start from src/tradedesk/data/alert_rules.example.json inside the image.
#TRADEDESK_ALERTS_ENABLED=1
#TRADEDESK_ALERTS_RULES_PATH=/data/alert_rules.json
#TRADEDESK_ALERTS_SECONDS=60
#TRADEDESK_ALERTS_DEFAULT_COOLDOWN=1800
# Telegram delivery (optional). Owner creates a bot with @BotFather, picks a chat_id.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
# TELEGRAM_TOPIC_ALERTS=          # forum topic id for market alerts (scripts/telegram_topics.py)

# Streamable-http auth. Comma-separated list of long random bearer tokens.
# Empty = no auth (bind to 127.0.0.1 or put a reverse proxy with its own auth in front).
# Generate: openssl rand -base64 32
#TRADEDESK_HTTP_BEARER_TOKEN=
#TRADEDESK_HTTP_BEARER_TOKENS=primary,backup

# Optional provider keys.
#COINGECKO_API_KEY=
#COINGECKO_PLAN=demo
#COINALYZE_API_KEY=
