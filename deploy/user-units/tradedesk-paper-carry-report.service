[Unit]
Description=tradedesk: weekly report of the forward paper carry books A and B (DB snapshot, no network, Telegram)

[Service]
Type=oneshot
WorkingDirectory=/home/tradedesk/tradedesk-mcp
ExecStart=/home/tradedesk/.local/bin/uv run python scripts/paper_carry_report.py --telegram
TimeoutStartSec=15min
Nice=10
NoNewPrivileges=true
