[Unit]
Description=tradedesk: monthly forward watch of three Hyperliquid vaults to Telegram (scripts/vault_watch_tg.py)
# Off until this file exists (the owner's decision of 2026-10-24 created it; removing it stops the reports).
ConditionPathExists=/var/lib/tradedesk-mcp/assistant/vault-watch.on

[Service]
Type=oneshot
WorkingDirectory=/home/tradedesk/tradedesk-mcp
ExecStart=/home/tradedesk/.local/bin/uv run --quiet python scripts/vault_watch_tg.py
TimeoutStartSec=5min
NoNewPrivileges=true
