[Unit]
Description=tradedesk: demo trader break-even rule (+30 % ROE -> stop to the entry), Bybit Demo Trading (ADR 0007)

[Service]
Type=oneshot
WorkingDirectory=/home/tradedesk/tradedesk-mcp
ExecStart=/home/tradedesk/.local/bin/uv run python -m tradedesk.execution.demo_trader --manage
TimeoutStartSec=50
Nice=5
NoNewPrivileges=true
